generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  
}

datasource db {
  provider = "mysql"
}

model Game {
  id            String        @id @default(uuid()) @map("game_id") @db.VarChar(36)
  name          String        @map("game_name") @db.VarChar(255)
  description   String        @db.VarChar(255)
  runCategories RunCategory[]
}

model RunCategory {
  id      String @id @default(uuid()) @db.VarChar(36)
  game_id String @db.VarChar(36)
  name    String @map("run_category_name") @db.VarChar(255)

  game Game @relation(fields: [game_id], references: [id])
}
